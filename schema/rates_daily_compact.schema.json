{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rates_daily_compact.json — series oficiales en columnas; las cruzadas se recalculan",
  "type": "object",
  "required": ["schema_version", "layout", "as_of", "series", "dates", "columns"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.(?!0\\.)"},
    "layout": {"const": "columnar"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pair", "quote_unit", "date_basis", "primary", "decimals", "method"],
        "properties": {
          "primary": {"type": "boolean"},
          "decimals": {"type": "integer", "minimum": 0},
          "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}
        }
      }
    },
    "dates": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    },
    "columns": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["filled", "values"],
        "properties": {
          "filled": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "values": {"type": "array", "items": {"type": ["number", "null"]}}
        },
        "additionalProperties": false
      }
    }
  }
}
